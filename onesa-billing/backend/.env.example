# Illustrative local configuration. Privately provision all credentials and replace IDs.
HOST=127.0.0.1
PORT=8099
BILLING_MODE=test
BILLING_ALLOW_LIVE=false
BILLING_SALES_ENABLED=false
BILLING_AUTOMATIC_TAX=false
BILLING_CONFIG_VERSION=replace-with-reviewed-version
STRIPE_ACCOUNT_ID=acct_REPLACE
STRIPE_SECRET_KEY_FILE=/run/secrets/stripe-test-key
STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe-webhook-signing-secret
BILLING_API_DATABASE_URL_FILE=/run/secrets/billing-api-database-url
BILLING_DISPATCHER_DATABASE_URL_FILE=/run/secrets/billing-dispatcher-database-url
BILLING_WEBHOOK_DATABASE_URL_FILE=/run/secrets/billing-webhook-database-url
BILLING_METER_DATABASE_URL_FILE=/run/secrets/billing-meter-database-url
# Migration authority is supplied only to the explicit migration process.
# BILLING_MIGRATION_DATABASE_URL_FILE=/run/secrets/billing-migration-database-url
BILLING_RETURN_ORIGIN=https://portal.example.invalid
BILLING_ALLOWED_ORIGINS=https://portal.example.invalid
BILLING_AUTH_ISSUER=https://portal.example.invalid/billing
BILLING_AUTH_JWKS_FILE=/run/config/billing-public-jwks.json
BILLING_CATALOG_FILE=/run/config/billing-catalog.json
# Replace with the agreed invoice terms. The service does not infer them.
BILLING_INVOICE_DAYS_UNTIL_DUE=14
# Replace the eight letters with a stable integration identifier before creating objects.
BILLING_INTEGRATION_IDENTIFIER=onesa_company_abcdefgh
# Optional independently configured Stripe customer portal.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE
# Metronome has a separately qualified sandbox/project/token and customer contracts.
# METRONOME_PROJECT_ID=replace-with-verified-project
# METRONOME_API_TOKEN_FILE=/run/secrets/metronome-sandbox-token
# BILLING_USAGE_BINDINGS_FILE=/run/config/verified-usage-bindings.json

{
  "name": "@onesa/company-billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:postgres": "node --import tsx --test test/store.integration.test.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "migrate": "node --import tsx src/migrate.ts",
    "migrate:production": "node dist/migrate.js"
  },
  "dependencies": {
    "fastify": "5.12.6",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

NODE_ENV=development
PORT=8300
DATABASE_URL=postgresql://onesa_portal:REPLACE_LOCALLY@127.0.0.1:5432/onesa_portal
SESSION_KEY=REPLACE_WITH_GENERATED_RANDOM_KEY
PUBLIC_ORIGIN=http://localhost:3300
STORAGE_DIR=./storage
PROXY_SHARED_KEY=REPLACE_WITH_GENERATED_RANDOM_KEY
PUBLISH_ENABLED=false
# Explicit owner-authorized pre-launch operation; launch restores legal prerequisites.
PUBLICATION_STAGE=launch
PUBLIC_RELEASE_ENABLED=false

# Optional production split: PUBLIC_ORIGIN=https://portal.onesa.eu, COMPANY_ORIGIN=https://onesa.eu
# Worker only: MAIL_PROVIDER=resend, RESEND_API_KEY (private), MAIL_FROM, MAIL_REPLY_TO

# Private operational scrape key; >=32 characters, no value in version control.
METRICS_TOKEN=
# Provisional shared logical storage ceilings; owner/capacity acceptance required.
MAX_FILE_STORAGE_BYTES=1073741824
MAX_OWNER_FILE_STORAGE_BYTES=134217728

# Render API and worker must share a private bucket and scoped credentials.
# S3_ENDPOINT/S3_REGION take precedence over the supported AWS aliases below.
S3_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

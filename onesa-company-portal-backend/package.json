{
  "name": "onesa-company-portal-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "node --env-file-if-exists=../.env --import tsx src/services/migrate.ts",
    "bootstrap": "node --env-file-if-exists=../.env --import tsx src/auth/bootstrap.ts",
    "worker": "node --env-file-if-exists=../.env --import tsx src/jobs/worker.ts",
    "documents": "node --import tsx src/documents/export.ts",
    "test:contracts": "node --import tsx --test tests/contracts.test.ts",
    "api:export": "node --import tsx src/api/export.ts",
    "seed": "node --env-file-if-exists=../.env --import tsx src/services/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/swagger": "^9.9.1",
    "fastify": "^5.8.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}

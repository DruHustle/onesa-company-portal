NODE_ENV=development
PORT=8300
DATABASE_PORT=55440
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://onesa_portal:replace-with-random-password@127.0.0.1:55440/onesa_portal
SESSION_KEY=replace-with-at-least-48-random-characters
PUBLIC_ORIGIN=http://localhost:3300
BACKEND_URL=http://127.0.0.1:8300
SITE_URL=http://localhost:3300
PUBLISH_ENABLED=false
PUBLIC_RELEASE_ENABLED=false
STORAGE_DIR=./storage
# Optional: CLAMAV_HOST, CLAMAV_PORT=3310
# Optional: S3_BUCKET, S3_ENDPOINT, S3_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Optional: SMTP_HOST, SMTP_PORT=587, SMTP_USER, SMTP_PASSWORD, MAIL_FROM, NOTIFY_EMAIL
# Bootstrap only: BOOTSTRAP_EMAIL and BOOTSTRAP_PASSWORD (minimum 14 characters)

PROXY_SHARED_KEY=replace-with-at-least-48-random-characters

# Frontend only: enable after approved HTTPS domain verification (no includeSubDomains).
ONESA_HSTS_ENABLED=false

# Optional production split: PUBLIC_ORIGIN=https://portal.onesa.eu, COMPANY_ORIGIN=https://onesa.eu
# Worker only: MAIL_PROVIDER=resend, RESEND_API_KEY (private), MAIL_FROM, MAIL_REPLY_TO

# Private operational scrape key; >=32 characters, no value in version control.
METRICS_TOKEN=
# Provisional shared logical storage ceilings; owner/capacity acceptance required.
MAX_FILE_STORAGE_BYTES=1073741824
MAX_OWNER_FILE_STORAGE_BYTES=134217728

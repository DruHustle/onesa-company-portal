# Render API and worker: same S3 bucket and separately reviewed restricted DB credentials.
NODE_ENV=production
DATABASE_URL=postgresql://onesa_portal_app:replace-password@replace-private-db/onesa_portal
PUBLIC_ORIGIN=https://portal.onesa.eu
COMPANY_ORIGIN=https://onesa.eu
SESSION_KEY=replace-with-at-least-48-random-characters
PROXY_SHARED_KEY=replace-with-at-least-48-random-characters
S3_BUCKET=s3-bucket
# Neon Object Storage: copy AWS_ENDPOINT_URL_S3 to S3_ENDPOINT and AWS_REGION to S3_REGION.
S3_ENDPOINT=https://replace-private-neon-storage-endpoint.example.invalid
S3_REGION=replace-with-storage-signing-region
AWS_ACCESS_KEY_ID=replace-scoped-access-key
AWS_SECRET_ACCESS_KEY=replace-scoped-secret
# Render worker only: send-only key scoped to verified mail.onesa.eu.
MAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-private-send-only-key
MAIL_FROM=Onesa <notifications@mail.onesa.eu>
# Set only after the recipient mailbox exists; this example does not create one.
MAIL_REPLY_TO=hello@onesa.eu
# API and worker: a real owner-approved inbox for notifications.
NOTIFY_EMAIL=replace-approved-recipient@example.invalid
CLAMAV_HOST=replace-private-scanner-host
CLAMAV_PORT=3310
PUBLISH_ENABLED=false
# Vercel portal project only: server-side BFF, approved site URL and release gate.
BACKEND_URL=https://replace-approved-render-api.example.invalid
SITE_URL=https://onesa.eu
PORTAL_URL=https://portal.onesa.eu
PUBLIC_RELEASE_ENABLED=false
ONESA_HSTS_ENABLED=false

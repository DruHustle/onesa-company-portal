.shell{min-height:100svh;background:var(--onesa-surface);padding:24px clamp(16px,5vw,64px) 64px;color:var(--onesa-text)}
.header{max-width:1080px;margin:0 auto 48px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.header select{min-height:44px;font:inherit;max-width:160px}
.brand{font-size:1.6rem;font-weight:600;letter-spacing:-.06em;text-decoration:none}
.brand span{font-size:.6rem;letter-spacing:.13em;margin-left:14px;font-weight:500}
.intro{max-width:720px;margin-bottom:32px}
.intro h1,.card h1{font-size:clamp(2rem,5vw,3rem);line-height:1.12;letter-spacing:-.045em;margin:0 0 16px;overflow-wrap:anywhere}
.intro p,.muted{color:var(--onesa-muted);line-height:1.65}
.workspace{max-width:1080px;margin:auto;min-width:0}
.card{max-width:480px;margin:auto;padding:clamp(22px,5vw,36px);border:1px solid var(--onesa-divider);border-radius:16px;background:var(--onesa-canvas);min-width:0;overflow-wrap:anywhere}
.card h1{font-size:clamp(1.75rem,5vw,2.25rem)}
.card fieldset,.manager fieldset{border:0;padding:0;margin:0;min-width:0}
.card label,.manager label{display:grid;gap:8px;margin:18px 0;font-size:.9rem;line-height:1.5}
.card :is(input,select),.manager :is(input,select){min-height:48px;border-radius:8px;font-size:1rem;width:100%;max-width:100%;min-width:0}
.card button,.manager button,.action{min-height:48px;padding:12px 18px;display:inline-flex;justify-content:center;align-items:center;text-align:center;gap:8px;border-radius:8px;white-space:normal;font-size:.9rem;line-height:1.4;text-decoration:none;cursor:pointer}
.card form>button,.card fieldset>button{width:100%;margin-top:12px}
.check{display:flex!important;flex-direction:row;align-items:center;min-height:44px;gap:12px!important;margin:12px 0!important}
.check input{min-height:24px!important;max-width:24px!important;width:24px!important;height:24px;flex-shrink:0}
.choices{margin:24px 0!important}
.choices legend{font-size:.95rem;font-weight:600;margin-bottom:8px}
.support{margin-top:24px;padding-top:20px;border-top:1px solid var(--onesa-divider);display:grid;gap:14px;font-size:.875rem;line-height:1.6}
.support a{text-decoration:underline;text-underline-offset:3px}
.notice{padding:16px 18px;background:var(--onesa-canvas);border:1px solid var(--onesa-divider);border-left:3px solid var(--onesa-accent);border-radius:8px;margin:20px 0;line-height:1.6;overflow-wrap:anywhere}
.toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:32px}
.toolbar p{margin:0;overflow-wrap:anywhere}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.product{padding:28px;border:1px solid var(--onesa-divider);border-radius:16px;background:var(--onesa-canvas);display:flex;flex-direction:column;align-items:flex-start;min-width:0}
.product h2{margin:22px 0 12px;font-size:1.35rem;letter-spacing:-.025em}
.product p{color:var(--onesa-muted);line-height:1.65;margin:0 0 24px;flex:1;overflow-wrap:anywhere}
.product .action{width:100%}
.badge{font-size:.72rem;line-height:1.5;padding:5px 9px;border:1px solid var(--onesa-divider);border-radius:5px;letter-spacing:.025em}
.accountLinks{margin-top:32px;display:flex;gap:12px;flex-wrap:wrap}
.manager{margin-top:48px;padding-top:32px;border-top:1px solid var(--onesa-divider)}
.manager h2{font-size:1.7rem;letter-spacing:-.03em;margin:0 0 12px}
.people{list-style:none;margin:24px 0;padding:0;display:grid;gap:12px}
.person{padding:20px;border:1px solid var(--onesa-divider);border-radius:12px;background:var(--onesa-canvas);min-width:0}
.person summary{min-height:44px;cursor:pointer;overflow-wrap:anywhere;line-height:1.5}
.person summary strong{display:block}
.formGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}
.wide{grid-column:1/-1}
.security{border-top:1px solid var(--onesa-divider);margin-top:24px!important;padding-top:12px!important}
.srOnly{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.shell :is(a,button,input,select,summary):focus-visible{outline:2px solid var(--onesa-accent);outline-offset:4px}
@media(max-width:760px){.grid{grid-template-columns:1fr}.header{margin-bottom:32px}.formGrid{grid-template-columns:1fr}.product{padding:24px}.accountLinks>*{flex:1 1 100%}.toolbar{align-items:flex-start}.shell{padding-top:20px}.brand span{margin-left:9px}}
@media(prefers-reduced-motion:reduce){.shell *{scroll-behavior:auto!important}}
@media(forced-colors:active){.product,.card,.person,.badge,.notice{border:1px solid CanvasText}.shell :is(a,button,input,select,summary):focus-visible{outline-color:Highlight}}

# Reference only; inject at runtime/build as described in the build guide.
BACKEND_URL=http://127.0.0.1:8300
FRONTEND_PORT=3300
SITE_URL=http://localhost:3300
PUBLIC_RELEASE_ENABLED=false
PUBLIC_ORIGIN=http://localhost:3300
# Server-only; must match backend when proxy trust is enabled.
PROXY_SHARED_KEY=REPLACE_WITH_GENERATED_RANDOM_KEY

# Vercel builds: stay below function payload limits including multipart/base64 overhead.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=3145728

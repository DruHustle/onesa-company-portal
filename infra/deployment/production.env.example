NODE_ENV=production
POSTGRES_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
PORTAL_OWNER_DATABASE_URL=postgresql://onesa_portal:REPLACE_WITH_OWNER_PASSWORD@database:5432/onesa_portal
PORTAL_APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
PORTAL_APP_DATABASE_URL=postgresql://onesa_portal_app:REPLACE_WITH_RANDOM_APP_PASSWORD@database:5432/onesa_portal
SESSION_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_48_CHARACTERS
PROXY_SHARED_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=https://portal.onesa.eu
COMPANY_ORIGIN=https://onesa.eu
BACKEND_URL=https://APPROVED_RENDER_BACKEND_HOSTNAME
SITE_URL=https://onesa.eu
PORTAL_URL=https://portal.onesa.eu
PORTAL_DOMAIN=portal.onesa.eu
PUBLISH_ENABLED=false
# Use prelaunch only under the owner-authorized pre-launch operating exception.
PUBLICATION_STAGE=launch
PUBLIC_RELEASE_ENABLED=false
S3_BUCKET=APPROVED_PRIVATE_BUCKET
S3_REGION=eu-central-1

# Worker-only transactional email; verify the sending domain before enabling.
MAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_PRIVATE_SEND_ONLY_KEY
MAIL_FROM=Onesa <notifications@mail.onesa.eu>
NOTIFY_EMAIL=replace-approved-recipient@example.invalid

# Private operational scrape key; >=32 characters, no value in version control.
METRICS_TOKEN=
# Provisional shared logical storage ceilings; owner/capacity acceptance required.
MAX_FILE_STORAGE_BYTES=1073741824
MAX_OWNER_FILE_STORAGE_BYTES=134217728

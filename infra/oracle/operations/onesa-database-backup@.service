[Unit]
Description=Onesa %i encrypted off-instance database backup
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/onesa/database-backups.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/onesa/portal-operations/current/infra/oracle/operations/database_snapshots.py --product %i
User=root
UMask=0077
TimeoutStartSec=240
Nice=10
IOSchedulingClass=idle
MemoryMax=768M
StandardOutput=journal
StandardError=journal

[Unit]
Description=Onesa private Portal metrics and failure notifications
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/onesa/portal-operations/current/infra/oracle/operations/monitor.py
User=root
UMask=0077
TimeoutStartSec=60
Nice=10
StandardOutput=journal
StandardError=journal

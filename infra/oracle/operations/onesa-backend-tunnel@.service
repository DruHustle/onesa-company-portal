[Unit]
Description=Onesa %i backend HTTPS tunnel
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/onesa/backends/tunnel-%i.token

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/onesa/backends/tunnel-%i.token
ExecStart=/usr/local/lib/onesa-tunnel/cloudflared-2026.10.1 --no-autoupdate tunnel --metrics 127.0.0.1:0 run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=192M
CPUQuota=10%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target

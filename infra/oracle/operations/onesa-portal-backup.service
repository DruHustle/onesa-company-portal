[Unit]
Description=Onesa Portal encrypted off-instance backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/onesa/portal-operations/current/infra/oracle/operations/backup.py
User=root
UMask=0077
TimeoutStartSec=240
Nice=10
IOSchedulingClass=idle
MemoryMax=768M
StandardOutput=journal
StandardError=journal

# STAGING ONLY. Blank REQUIRED values come privately from real isolated resources.
# See docs/engineering/FREE_STAGING_SETUP.md; never overwrite a populated .env.
# API (Render Free): production security rules also apply to hosted staging.
NODE_ENV=production
DATABASE_URL=""
SESSION_KEY=""
PROXY_SHARED_KEY=""
METRICS_TOKEN=""
PUBLIC_ORIGIN=https://portal-staging.example.invalid
COMPANY_ORIGIN=https://company-staging.example.invalid
PUBLISH_ENABLED=false
S3_BUCKET=onesa-portal-staging
S3_ENDPOINT=""
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Do not reuse the exposed production bucket credential or guess its endpoint.
# Oracle Compose supplies CLAMAV_SOCKET=/run/onesa-scanner/clamd.sock; no TCP scanner host/port.
MAX_FILE_STORAGE_BYTES=268435456
MAX_OWNER_FILE_STORAGE_BYTES=67108864
# SMTP default leaves delivery disabled with no SMTP host. Do not invent delivery.
MAIL_PROVIDER=smtp
# Worker-only after approved test recipient and privately supplied fresh Resend key:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=<private-new-send-only-key>
MAIL_FROM=Onesa Staging <notifications@mail.onesa.eu>
MAIL_REPLY_TO=info@onesa.eu
# Leave NOTIFY_EMAIL unset until an actual test recipient is approved.
# FRONTEND ONLY: use the SAME staging proxy key as its API, never NEXT_PUBLIC.
BACKEND_URL=""
SITE_URL=https://company-staging.example.invalid
PORTAL_URL=https://portal-staging.example.invalid
PUBLIC_RELEASE_ENABLED=false
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
# Migration process uses DATABASE_URL with its isolated owner/migration role.
# Runtime and worker use DATABASE_URL with the restricted application role.
